{
  "name": "dotnet-project-creator",
  "displayName": ".NET Project Creator",
  "description": "An interactive extension with command pallet commands, made for the creation of new .NET projects using available templates, as well as downloading new templates.",
  "author": "Terongorus",
  "publisher": "Terongorus",
  "version": "1.1.0",
  "icon": "resources/appicon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Terongorus/dotnet-project-creator"
  },
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Extension Packs",
    "Programming Languages",
    "Visualization",
    "Snippets",
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "dotnet-creator.newProject",
        "icon": "resources/appicon.png",
        "title": "Create New Project",
        "category": ".NET"
      },
      {
        "command": "dotnet-creator.createSolution",
        "icon": "resources/appicon.png",
        "title": "Create Solution",
        "category": ".NET"
      },
      {
        "command": "dotnet-creator.manageSolution",
        "icon": "resources/appicon.png",
        "title": "Manage Solution Files",
        "category": ".NET"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.125.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "ts-loader": "^9.6.2",
    "webpack": "^5.107.2",
    "webpack-cli": "^7.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
