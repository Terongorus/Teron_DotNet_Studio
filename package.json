        "label": "JetBrains Rider Dark",
        "uiTheme": "vs-dark",
        "path": "resources/themes/jetbrains-rider-dark-theme.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package && npm run build:designer-host",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "build:designer-host": "npm run build:designer-host:x64 && npm run build:designer-host:x86",
    "build:designer-host:x64": "dotnet publish designer-host/DesignerHost.csproj -c Release -r win-x64 --self-contained false -o dist/designer-host/win-x64",
    "build:designer-host:x86": "dotnet publish designer-host/DesignerHost.csproj -c Release -r win-x86 --self-contained false -o dist/designer-host/win-x86",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/ssh2-sftp-client": "^9.0.6",
    "@types/tar-stream": "^3.1.4",
    "@types/vscode": "^1.125.0",
    "@types/yauzl": "^3.4.0",
    "@vscode/codicons": "^0.0.46-24",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "eslint": "^10.5.0",
    "ts-loader": "^9.6.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1",
    "webpack": "^5.107.2",
    "webpack-cli": "^7.0.3"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1",
    "ssh2-sftp-client": "^12.1.1",
    "tar-stream": "^3.2.0",
    "vscode-jsonrpc": "^9.0.1",
    "vscode-languageclient": "^10.1.0",
    "yauzl": "^3.4.0"
  }
