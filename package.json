      ],
      "activitybar": [
        {
          "id": "dotnetSolutionExplorerContainer",
          "title": ".NET Solution Explorer",
          "icon": "resources/solution-explorer-icon.svg"
        }
      ]
    },
    "views": {
      "dotnetResourceMonitor": [
        {
          "id": "dotnet-studio.resourceMonitorView",
          "name": "Resource Monitor",
          "type": "webview",
          "icon": "resources/debug-monitor-icon.svg",
          "when": "dotnet-studio.projectOpened"
        }
      ],
      "dotnetSolutionExplorerContainer": [
        {
          "id": "dotnet-studio.solutionExplorerView",
