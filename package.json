          "group": "2_open@2"
        },
        {
          "command": "dotnet-studio.solutionExplorer.editProjectFile",
          "when": "view == dotnet-studio.solutionExplorerView && viewItem =~ /^dotnetProject\\b/",
          "group": "2_open@3"
        },
        {
          "command": "dotnet-studio.solutionExplorer.editSolutionFile",
          "when": "view == dotnet-studio.solutionExplorerView && viewItem == dotnetSolution",
          "group": "2_open@3"
        },
        {
          "command": "dotnet-studio.solutionExplorer.openNugetManager",
          "when": "view == dotnet-studio.solutionExplorerView && viewItem == dotnetDependencies",
          "group": "3_deps@1"
        },
        {
          "command": "dotnet-studio.solutionExplorer.manageProjectReferences",
          "when": "view == dotnet-studio.solutionExplorerView && viewItem == dotnetDependencies",
          "group": "3_deps@2"
        },
        {
          "command": "dotnet-studio.solutionExplorer.openNugetManager",
          "when": "view == dotnet-studio.solutionExplorerView && viewItem =~ /^dotnetProject\\b/",
          "group": "3_deps@1"
        },
        {
          "command": "dotnet-studio.solutionExplorer.cut",
          "when": "view == dotnet-studio.solutionExplorerView && viewItem =~ /\\bcanCut\\b/",
          "group": "4_clipboard@1"
        },
        {
          "command": "dotnet-studio.solutionExplorer.copy",
          "when": "view == dotnet-studio.solutionExplorerView && viewItem =~ /\\bcanCopy\\b/",
          "group": "4_clipboard@2"
        },
        {
          "command": "dotnet-studio.solutionExplorer.paste",
          "when": "view == dotnet-studio.solutionExplorerView && (viewItem =~ /^dotnetProject\\b/ || viewItem =~ /\\bcanNew\\b/)",
          "group": "4_clipboard@3"
        },
        {
          "command": "dotnet-studio.solutionExplorer.copyPath",
          "when": "view == dotnet-studio.solutionExplorerView && viewItem =~ /^dotnet(Folder|File)\\b/",
          "group": "5_copyPath@1"
        },
        {
          "command": "dotnet-studio.solutionExplorer.copyRelativePath",
          "when": "view == dotnet-studio.solutionExplorerView && viewItem =~ /^dotnet(Folder|File)\\b/",
          "group": "5_copyPath@2"
        },
        {
          "command": "dotnet-studio.solutionExplorer.run",
          "when": "view == dotnet-studio.solutionExplorerView && viewItem =~ /^dotnetProject\\b/",
          "group": "6_build@1"
        },
        {
          "command": "dotnet-studio.solutionExplorer.build",
          "when": "view == dotnet-studio.solutionExplorerView && (viewItem =~ /^dotnetProject\\b/ || viewItem == dotnetSolution)",
          "group": "6_build@2"
        },
        {
          "command": "dotnet-studio.solutionExplorer.rebuild",
          "when": "view == dotnet-studio.solutionExplorerView && (viewItem =~ /^dotnetProject\\b/ || viewItem == dotnetSolution)",
          "group": "6_build@3"
        },
        {
          "command": "dotnet-studio.solutionExplorer.clean",
          "when": "view == dotnet-studio.solutionExplorerView && (viewItem =~ /^dotnetProject\\b/ || viewItem == dotnetSolution)",
          "group": "6_build@4"
        },
        {
          "command": "dotnet-studio.solutionExplorer.publish",
          "when": "view == dotnet-studio.solutionExplorerView && viewItem =~ /^dotnetProject\\b/",
          "group": "6b_publish@1"
        },
        {
          "command": "dotnet-studio.solutionExplorer.setAsStartupProject",
          "when": "view == dotnet-studio.solutionExplorerView && viewItem =~ /^dotnetProject\\b/",
          "group": "7_startup@1"
        },
        {
          "command": "dotnet-studio.solutionExplorer.exclude",
          "when": "view == dotnet-studio.solutionExplorerView && viewItem =~ /\\bcanExclude\\b/",
          "group": "8_modify@1"
        },
        {
          "command": "dotnet-studio.solutionExplorer.include",
          "when": "view == dotnet-studio.solutionExplorerView && viewItem =~ /\\bcanInclude\\b/",
          "group": "8_modify@1"
        },
        {
          "command": "dotnet-studio.solutionExplorer.rename",
          "when": "view == dotnet-studio.solutionExplorerView && viewItem =~ /\\bcanRename\\b/",
          "group": "8_modify@2"
        },
        {
          "command": "dotnet-studio.solutionExplorer.delete",
