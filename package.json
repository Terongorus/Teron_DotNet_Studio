      "view/title": [
        {
          "command": "dotnet-creator.solutionExplorer.refresh",
          "when": "view == dotnet-creator.solutionExplorerView",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "dotnet-creator.previewXamlDesigner",
          "when": "view == dotnet-creator.solutionExplorerView && viewItem == dotnetFile && resourceExtname == .xaml",
          "group": "navigation"
        },
        {
          "command": "dotnet-creator.solutionExplorer.newFile",
          "when": "view == dotnet-creator.solutionExplorerView && (viewItem == dotnetProject || viewItem =~ /\\bcanNew\\b/)",
          "group": "1_new@1"
        },
        {
          "command": "dotnet-creator.solutionExplorer.newClass",
          "when": "view == dotnet-creator.solutionExplorerView && (viewItem == dotnetProject || viewItem =~ /\\bcanNew\\b/)",
          "group": "1_new@2"
        },
        {
          "command": "dotnet-creator.solutionExplorer.newFolder",
          "when": "view == dotnet-creator.solutionExplorerView && (viewItem == dotnetProject || viewItem =~ /\\bcanNew\\b/)",
          "group": "1_new@3"
        },
        {
          "command": "dotnet-creator.solutionExplorer.addExistingFile",
          "when": "view == dotnet-creator.solutionExplorerView && (viewItem == dotnetProject || viewItem =~ /\\bcanNew\\b/)",
          "group": "1_new@4"
        },
        {
          "command": "dotnet-creator.solutionExplorer.revealInFileExplorer",
          "when": "view == dotnet-creator.solutionExplorerView && (viewItem == dotnetProject || viewItem == dotnetSolution || viewItem =~ /^dotnet(Folder|File)\\b/)",
          "group": "2_open@1"
        },
        {
          "command": "dotnet-creator.solutionExplorer.openInIntegratedTerminal",
          "when": "view == dotnet-creator.solutionExplorerView && (viewItem == dotnetProject || viewItem == dotnetSolution || viewItem =~ /^dotnet(Folder|File)\\b/)",
          "group": "2_open@2"
        },
        {
          "command": "dotnet-creator.solutionExplorer.editProjectFile",
          "when": "view == dotnet-creator.solutionExplorerView && viewItem =~ /^dotnetProject\\b/",
          "group": "2_open@3"
        },
        {
          "command": "dotnet-creator.solutionExplorer.editSolutionFile",
          "when": "view == dotnet-creator.solutionExplorerView && viewItem == dotnetSolution",
          "group": "2_open@3"
        },
        {
          "command": "dotnet-creator.solutionExplorer.openNugetManager",
          "when": "view == dotnet-creator.solutionExplorerView && viewItem == dotnetDependencies",
          "group": "3_deps@1"
        },
        {
          "command": "dotnet-creator.solutionExplorer.manageProjectReferences",
          "when": "view == dotnet-creator.solutionExplorerView && viewItem == dotnetDependencies",
          "group": "3_deps@2"
        },
        {
          "command": "dotnet-creator.solutionExplorer.openNugetManager",
          "when": "view == dotnet-creator.solutionExplorerView && viewItem =~ /^dotnetProject\\b/",
          "group": "3_deps@1"
        },
        {
          "command": "dotnet-creator.solutionExplorer.cut",
          "when": "view == dotnet-creator.solutionExplorerView && viewItem =~ /\\bcanCut\\b/",
          "group": "4_clipboard@1"
        },
        {
          "command": "dotnet-creator.solutionExplorer.copy",
          "when": "view == dotnet-creator.solutionExplorerView && viewItem =~ /\\bcanCopy\\b/",
          "group": "4_clipboard@2"
        },
        {
          "command": "dotnet-creator.solutionExplorer.paste",
          "when": "view == dotnet-creator.solutionExplorerView && (viewItem == dotnetProject || viewItem =~ /\\bcanNew\\b/)",
          "group": "4_clipboard@3"
        },
        {
          "command": "dotnet-creator.solutionExplorer.copyPath",
          "when": "view == dotnet-creator.solutionExplorerView && viewItem =~ /^dotnet(Folder|File)\\b/",
          "group": "5_copyPath@1"
        },
        {
          "command": "dotnet-creator.solutionExplorer.copyRelativePath",
          "when": "view == dotnet-creator.solutionExplorerView && viewItem =~ /^dotnet(Folder|File)\\b/",
          "group": "5_copyPath@2"
        },
        {
          "command": "dotnet-creator.solutionExplorer.run",
          "when": "view == dotnet-creator.solutionExplorerView && viewItem =~ /^dotnetProject\\b/",
          "group": "6_build@1"
        },
        {
          "command": "dotnet-creator.solutionExplorer.build",
          "when": "view == dotnet-creator.solutionExplorerView && (viewItem =~ /^dotnetProject\\b/ || viewItem == dotnetSolution)",
          "group": "6_build@2"
        },
        {
          "command": "dotnet-creator.solutionExplorer.rebuild",
          "when": "view == dotnet-creator.solutionExplorerView && (viewItem =~ /^dotnetProject\\b/ || viewItem == dotnetSolution)",
          "group": "6_build@3"
        },
        {
          "command": "dotnet-creator.solutionExplorer.clean",
          "when": "view == dotnet-creator.solutionExplorerView && (viewItem =~ /^dotnetProject\\b/ || viewItem == dotnetSolution)",
          "group": "6_build@4"
        },
        {
          "command": "dotnet-creator.solutionExplorer.setAsStartupProject",
          "when": "view == dotnet-creator.solutionExplorerView && viewItem =~ /^dotnetProject\\b/",
          "group": "7_startup@1"
        },
        {
          "command": "dotnet-creator.solutionExplorer.exclude",
          "when": "view == dotnet-creator.solutionExplorerView && viewItem =~ /\\bcanExclude\\b/",
          "group": "8_modify@1"
        },
        {
          "command": "dotnet-creator.solutionExplorer.include",
          "when": "view == dotnet-creator.solutionExplorerView && viewItem =~ /\\bcanInclude\\b/",
          "group": "8_modify@1"
        },
        {
          "command": "dotnet-creator.solutionExplorer.rename",
          "when": "view == dotnet-creator.solutionExplorerView && viewItem =~ /\\bcanRename\\b/",
          "group": "8_modify@2"
        },
        {
          "command": "dotnet-creator.solutionExplorer.delete",
          "when": "view == dotnet-creator.solutionExplorerView && viewItem =~ /\\bcanDelete\\b/",
          "group": "8_modify@3"
        },
        {
          "command": "dotnet-creator.solutionExplorer.removeFromSolution",
          "when": "view == dotnet-creator.solutionExplorerView && viewItem =~ /\\binSolution\\b/",
          "group": "9_remove@1"
        }
      ]
    },
    "keybindings": [
      {
        "key": "f5",
        "command": "dotnet-creator.debugStart",
        "when": "dotnet-creator.workspaceHasProject && !inDebugMode"
      },
      {
        "key": "ctrl+f5",
        "command": "dotnet-creator.runWithoutDebugging",
        "when": "dotnet-creator.workspaceHasProject && !inDebugMode"
      }
    ],
