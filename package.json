      "view/title": [
        {
          "command": "dotnet-studio.solutionExplorer.refresh",
          "when": "view == dotnet-studio.solutionExplorerView",
          "group": "navigation"
        },
        {
          "command": "dotnet-studio.profiler.startTrace",
          "when": "view == dotnet-studio.resourceMonitorView && !dotnet-studio.resourceMonitor.tracing",
          "group": "navigation"
        },
        {
          "command": "dotnet-studio.profiler.stopTrace",
          "when": "view == dotnet-studio.resourceMonitorView && dotnet-studio.resourceMonitor.tracing",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "dotnet-studio.previewXamlDesigner",
          "when": "view == dotnet-studio.solutionExplorerView && viewItem == dotnetFile && resourceExtname == .xaml",
          "group": "navigation"
        },
        {
          "command": "dotnet-studio.solutionExplorer.newFile",
          "when": "view == dotnet-studio.solutionExplorerView && (viewItem =~ /^dotnetProject\\b/ || viewItem =~ /\\bcanNew\\b/)",
          "group": "1_new@1"
        },
        {
          "command": "dotnet-studio.solutionExplorer.newClass",
          "when": "view == dotnet-studio.solutionExplorerView && (viewItem =~ /^dotnetProject\\b/ || viewItem =~ /\\bcanNew\\b/)",
          "group": "1_new@2"
        },
        {
          "command": "dotnet-studio.solutionExplorer.newFolder",
          "when": "view == dotnet-studio.solutionExplorerView && (viewItem =~ /^dotnetProject\\b/ || viewItem =~ /\\bcanNew\\b/)",
          "group": "1_new@3"
        },
        {
          "command": "dotnet-studio.solutionExplorer.addExistingFile",
          "when": "view == dotnet-studio.solutionExplorerView && (viewItem =~ /^dotnetProject\\b/ || viewItem =~ /\\bcanNew\\b/)",
          "group": "1_new@4"
        },
        {
          "command": "dotnet-studio.solutionExplorer.revealInFileExplorer",
          "when": "view == dotnet-studio.solutionExplorerView && (viewItem =~ /^dotnetProject\\b/ || viewItem == dotnetSolution || viewItem =~ /^dotnet(Folder|File)\\b/)",
          "group": "2_open@1"
        },
        {
          "command": "dotnet-studio.solutionExplorer.openInIntegratedTerminal",
