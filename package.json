    "keybindings": [
      {
        "key": "f5",
        "command": "dotnet-studio.debugStart",
        "when": "dotnet-studio.projectOpened"
      },
      {
        "key": "ctrl+f5",
        "command": "dotnet-studio.runWithoutDebugging",
        "when": "dotnet-studio.projectOpened"
      },
      {
        "key": "ctrl+k b",
        "command": "dotnet-studio.buildProject",
        "when": "dotnet-studio.projectOpened"
      },
      {
        "key": "ctrl+k shift+b",
        "command": "dotnet-studio.rebuildProject",
        "when": "dotnet-studio.projectOpened"
      },
      {
        "key": "ctrl+k c",
        "command": "dotnet-studio.cleanProject",
        "when": "dotnet-studio.projectOpened"
      },
      {
        "key": "ctrl+k ctrl+b",
        "command": "dotnet-studio.buildSolution",
        "when": "dotnet-studio.projectOpened"
      },
      {
        "key": "ctrl+k ctrl+shift+b",
        "command": "dotnet-studio.rebuildSolution",
        "when": "dotnet-studio.projectOpened"
      },
      {
        "key": "ctrl+k ctrl+c",
        "command": "dotnet-studio.cleanSolution",
        "when": "dotnet-studio.projectOpened"
      }
    ],
    "viewsContainers": {
      "panel": [
