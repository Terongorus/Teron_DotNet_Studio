          "group": "9_remove@1"
        },
        {
          "command": "dotnet-studio.solutionExplorer.unloadProject",
          "when": "view == dotnet-studio.solutionExplorerView && viewItem =~ /\\binSolution\\b/ && !(viewItem =~ /\\bunloaded\\b/)",
          "group": "9_remove@2"
        },
        {
          "command": "dotnet-studio.solutionExplorer.reloadProject",
          "when": "view == dotnet-studio.solutionExplorerView && viewItem =~ /\\bunloaded\\b/",
          "group": "9_remove@2"
        }
      ]
