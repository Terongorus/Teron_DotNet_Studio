    "debuggers": [
      {
        "type": "dotnet-studio-debug",
        "label": ".NET (netcoredbg)",
        "languages": [
          "csharp"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "program"
            ],
            "properties": {
              "program": {
                "type": "string",
                "description": "Path to the built .dll to debug.",
                "default": "${input:pickAssembly}"
              },
              "cwd": {
                "type": "string",
                "description": "Working directory for the launched program.",
                "default": "${workspaceFolder}"
              },
              "args": {
                "type": "array",
                "description": "Command line arguments passed to the program.",
                "default": []
              },
              "stopAtEntry": {
                "type": "boolean",
                "description": "Break immediately when the program starts.",
                "default": false
              },
              "console": {
                "type": "string",
                "enum": [
                  "internalConsole",
                  "integratedTerminal",
                  "externalTerminal"
                ],
                "description": "Where to launch the debug target's console output.",
                "default": "internalConsole"
              },
              "env": {
                "type": "object",
                "description": "Environment variables for the launched program.",
                "default": {}
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "name": ".NET Debug",
            "type": "dotnet-studio-debug",
            "request": "launch",
            "program": "${input:pickAssembly}",
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false
          }
        ],
        "configurationSnippets": [
          {
            "label": ".NET: Launch (netcoredbg)",
            "description": "Launch a .NET project with netcoredbg.",
            "body": {
              "name": ".NET Debug",
              "type": "dotnet-studio-debug",
              "request": "launch",
              "program": "^\"\\${input:pickAssembly}\"",
              "cwd": "^\"\\${workspaceFolder}\"",
              "stopAtEntry": false
            }
          }
        ]
      },
      {
        "type": "dotnet-creator-debug",
        "label": ".NET (netcoredbg) [Legacy]",
        "languages": [
          "csharp"
        ]
      }
    ],
    "configuration": [
      {
        "title": ".NET Studio",
        "order": 0,
        "properties": {
          "dotnet-studio.showStartPageOnStartup": {
            "type": "boolean",
            "default": true,
            "description": "Automatically show the .NET Studio start page on launch when no folder or workspace is open."
          },
          "dotnet-studio.dotnetPath": {
            "type": "string",
            "default": "",
            "description": "Path to a specific dotnet executable to use for every dotnet CLI invocation this extension makes - build/restore/publish, NuGet, Test Explorer, debug launches, and both language servers (unless a component has its own more specific dotnetPath set, which takes priority for that component). Set this if the VS Code Extension Host can't see your real .NET SDK: it inherits the machine's own environment variables directly, so a user-local SDK install that only your terminal has been manually redirected to (common without admin rights, where a system-wide install isn't possible) stays invisible to it even though your terminal resolves 'dotnet' correctly. Leave empty to resolve 'dotnet' from PATH as normal."
          },
          "dotnet-studio.offerDebugTaskSetup": {
            "type": "boolean",
            "default": true,
            "description": "Offer to set up .NET debug/build tasks.json and launch.json entries when a .NET workspace doesn't have them yet."
          },
          "dotnet-studio.useGlobalDebugTasks": {
            "type": "boolean",
            "default": false,
            "description": "Use global (User Tasks/launch) .NET debug/build configurations shared across every workspace, instead of setting them up per-workspace. Created automatically the first time they're needed. When enabled, the per-workspace setup prompt is skipped entirely."
          },
          "dotnet-studio.languageServer": {
            "type": "string",
            "enum": [
              "sharpLsp",
              "roslyn"
            ],
            "enumDescriptions": [
              "SharpLsp - a third-party, MIT-licensed C#/F# language server.",
              "Roslyn Language Server - Microsoft's own C# language server, the same one C# Dev Kit uses internally, driven standalone (not via C# Dev Kit)."
            ],
            "default": "sharpLsp",
            "description": "Which C#/F# language server .NET Studio drives. Both can be installed at once, but only the selected one ever runs - use \".NET: Switch Language Server\" to change this and restart."
          }
        }
      },
      {
        "title": "SharpLsp Language Server",
        "order": 1,
        "properties": {
          "dotnet-studio.sharpLsp.enabled": {
            "type": "boolean",
            "default": true,
            "description": "Enable C# and F# language features (diagnostics, completion, hover, go-to-definition) via a SharpLsp binary already installed on PATH. Disable if you're using another C# language extension."
          },
          "dotnet-studio.sharpLsp.path": {
            "type": "string",
            "default": "",
            "description": "Path to the SharpLsp executable. Leave empty to resolve 'sharplsp' from PATH, or to use a copy downloaded via the \"Download SharpLsp\" action."
          },
          "dotnet-studio.sharpLsp.extraArgs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "description": "Extra command-line arguments passed to the SharpLsp server process."
          },
          "dotnet-studio.sharpLsp.trace.server": {
            "type": "string",
            "enum": [
              "off",
              "messages",
              "verbose"
            ],
            "default": "off",
            "description": "Trace communication between .NET Studio and the SharpLsp language server (for troubleshooting)."
          }
        }
      },
      {
        "title": "Roslyn Language Server",
        "order": 2,
        "properties": {
          "dotnet-studio.roslyn.path": {
            "type": "string",
            "default": "",
            "description": "Path to the Roslyn Language Server executable. Leave empty to resolve it from PATH, or to use a copy downloaded via the \"Download Roslyn Language Server\" action."
          },
          "dotnet-studio.roslyn.extraArgs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "description": "Extra command-line arguments passed to the Roslyn Language Server process."
          }
        }
      },
      {
        "title": "Debugger (netcoredbg)",
        "order": 3,
        "properties": {
          "dotnet-studio.debugAdapter.path": {
            "type": "string",
            "default": "",
            "description": "Path to the netcoredbg executable. Leave empty to resolve 'netcoredbg' from PATH, or to use a copy downloaded via the \"Download netcoredbg\" action."
          },
          "dotnet-studio.debugAdapter.extraArgs": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "description": "Extra command-line arguments passed to the netcoredbg process."
          }
        }
      },
      {
        "title": "Publish: Web Deploy",
        "order": 4,
        "properties": {
          "dotnet-studio.webDeploy.path": {
            "type": "string",
            "default": "",
            "description": "Path to msdeploy.exe, required to publish to a Web Server target. Leave empty to resolve it from a well-known Web Deploy install location or PATH."
          }
        }
      }
    ],
