    "debuggers": [
      {
        "type": "dotnet-creator-debug",
        "label": ".NET (netcoredbg)",
        "languages": ["csharp"],
        "configurationAttributes": {
          "launch": {
            "required": ["program"],
            "properties": {
              "program": {
                "type": "string",
                "description": "Path to the built .dll to debug.",
                "default": "${input:pickAssembly}"
              },
              "cwd": {
                "type": "string",
                "description": "Working directory for the launched program.",
                "default": "${workspaceFolder}"
              },
              "args": {
                "type": "array",
                "description": "Command line arguments passed to the program.",
                "default": []
              },
              "stopAtEntry": {
                "type": "boolean",
                "description": "Break immediately when the program starts.",
                "default": false
              },
              "console": {
                "type": "string",
                "enum": ["internalConsole", "integratedTerminal", "externalTerminal"],
                "description": "Where to launch the debug target's console output.",
                "default": "internalConsole"
              },
              "env": {
                "type": "object",
                "description": "Environment variables for the launched program.",
                "default": {}
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "name": ".NET Debug",
            "type": "dotnet-creator-debug",
            "request": "launch",
            "program": "${input:pickAssembly}",
            "cwd": "${workspaceFolder}",
            "stopAtEntry": false
          }
        ],
        "configurationSnippets": [
          {
            "label": ".NET: Launch (netcoredbg)",
            "description": "Launch a .NET project with netcoredbg.",
            "body": {
              "name": ".NET Debug",
              "type": "dotnet-creator-debug",
              "request": "launch",
              "program": "^\"\\${input:pickAssembly}\"",
              "cwd": "^\"\\${workspaceFolder}\"",
              "stopAtEntry": false
            }
          }
        ]
      }
    ],
    "configuration": {
      "title": ".NET Project Creator",
      "properties": {
        "dotnet-creator.showStartPageOnStartup": {
          "type": "boolean",
          "default": true,
          "description": "Automatically show the .NET Project Creator start page on launch when no folder or workspace is open."
        },
        "dotnet-creator.offerDebugTaskSetup": {
          "type": "boolean",
          "default": true,
          "description": "Offer to set up .NET debug/build tasks.json and launch.json entries when a .NET workspace doesn't have them yet."
        },
        "dotnet-creator.sharpLsp.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable C# and F# language features (diagnostics, completion, hover, go-to-definition) via a SharpLsp binary already installed on PATH. Disable if you're using another C# language extension."
        },
        "dotnet-creator.sharpLsp.path": {
          "type": "string",
          "default": "",
          "description": "Path to the SharpLsp executable. Leave empty to resolve 'sharplsp' from PATH, or to use a copy downloaded via the \"Download SharpLsp\" action."
        },
        "dotnet-creator.sharpLsp.extraArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Extra command-line arguments passed to the SharpLsp server process."
        },
        "dotnet-creator.sharpLsp.dotnetPath": {
          "type": "string",
          "default": "",
          "description": "Path to a specific dotnet executable (e.g. a portable/user-local .NET SDK install not on PATH) for the SharpLsp language server to use."
        },
        "dotnet-creator.sharpLsp.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Trace communication between .NET Studio and the SharpLsp language server (for troubleshooting)."
        },
        "dotnet-creator.debugAdapter.path": {
          "type": "string",
          "default": "",
          "description": "Path to the netcoredbg executable. Leave empty to resolve 'netcoredbg' from PATH, or to use a copy downloaded via the \"Download netcoredbg\" action."
        },
        "dotnet-creator.debugAdapter.extraArgs": {
          "type": "array",
          "items": { "type": "string" },
          "default": [],
          "description": "Extra command-line arguments passed to the netcoredbg process."
        }
      }
    },
