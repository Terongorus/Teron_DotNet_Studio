      "explorer/context": [
        {
          "command": "dotnet-creator.previewXamlDesigner",
          "when": "resourceExtname == .xaml",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "dotnet-creator.previewXamlDesigner",
          "when": "resourceExtname == .xaml",
